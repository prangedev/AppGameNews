# ============================================================================
# AppGameNews — exemplo de configuração. Copie para .env e preencha.
# NUNCA versione o .env real. Todos os segredos abaixo são placeholders.
# ============================================================================

# --- Ambiente ---------------------------------------------------------------
NODE_ENV=development
# porta HTTP da API
PORT=3000
# URL pública da API (usada em links de e-mail, callbacks OAuth, CORS)
PUBLIC_API_URL=http://localhost:3000
# origens permitidas para CORS (separadas por vírgula). Em prod, sem "*".
CORS_ORIGINS=http://localhost:5173,chrome-extension://REPLACE_WITH_EXTENSION_ID
# nível de log: fatal|error|warn|info|debug|trace
LOG_LEVEL=debug

# --- Banco / fila ---------------------------------------------------------------
DATABASE_URL=postgresql://appgamenews:appgamenews@localhost:5432/appgamenews?schema=public
REDIS_URL=redis://localhost:6379

# --- Segredos de autenticação --------------------------------------------------
# gere com: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_dev_only_access_secret
JWT_REFRESH_SECRET=CHANGE_ME_dev_only_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# chave de 32 bytes (base64) para cifrar tokens de terceiros em repouso
DATA_ENCRYPTION_KEY=CHANGE_ME_base64_32_bytes

# --- E-mail (verificação / reset) --------------------------------------------
# em dev usamos MailHog (docker-compose). Em prod, SMTP real.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="AppGameNews <no-reply@appgamenews.local>"

# --- OAuth: Google ----------------------------------------------------------
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# --- OAuth: Steam (OpenID 2.0) -------------------------------------------------
# https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
STEAM_REALM=http://localhost:3000/
STEAM_CALLBACK_URL=http://localhost:3000/auth/steam/callback

# --- OAuth: Epic Games (OIDC / Epic Online Services) ------------------------
# https://dev.epicgames.com/portal -> Product -> Client credentials
EPIC_CLIENT_ID=
EPIC_CLIENT_SECRET=
EPIC_CALLBACK_URL=http://localhost:3000/auth/epic/callback

# --- Clientes que trocam "code" por tokens (extensão / app) ------------------
# páginas de redirecionamento permitidas após OAuth (allowlist estrita)
OAUTH_POST_LOGIN_REDIRECTS=appgamenews://auth,chrome-extension://REPLACE_WITH_EXTENSION_ID/auth.html

# --- Fontes de dados externas ------------------------------------------------
# CheapShark não exige chave.
CHEAPSHARK_BASE_URL=https://www.cheapshark.com/api/1.0
# IsThereAnyDeal: https://isthereanydeal.com/apps/  (deixe vazio p/ desligar)
ITAD_API_KEY=
ITAD_BASE_URL=https://api.isthereanydeal.com
# RAWG: https://rawg.io/apidocs  (deixe vazio p/ desligar)
RAWG_API_KEY=
RAWG_BASE_URL=https://api.rawg.io/api
# Steam storefront (sem chave) + Web API (opcional, p/ notícias)
STEAM_STOREFRONT_BASE_URL=https://store.steampowered.com/api
STEAM_WEBAPI_BASE_URL=https://api.steampowered.com
EPIC_FREEGAMES_URL=https://store-site-backend-static.ak.epicgames.com/freeGamesPromotions

# --- Push (Firebase Cloud Messaging) --------------------------------------------
# caminho para o JSON da service account, OU o JSON inteiro em base64
FCM_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
FCM_SERVICE_ACCOUNT_BASE64=

# --- Rate limiting ---------------------------------------------------------------
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Observabilidade ----------------------------------------------------------
SENTRY_DSN=

# --- Flags de ingestão --------------------------------------------------------
INGEST_ENABLED=true
INGEST_CHEAPSHARK_CRON=*/30 * * * *
INGEST_EPIC_CRON=0 * * * *
INGEST_STEAM_CRON=0 * * * *
INGEST_ITAD_CRON=0 */6 * * *
INGEST_RAWG_CRON=0 */12 * * *
